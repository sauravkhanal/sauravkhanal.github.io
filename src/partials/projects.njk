<section id="projects" class="pt-10 scroll-mt-24">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
    <h2 class="text-4xl md:text-6xl font-black uppercase flex items-center gap-4">
      <div class="bg-rose-300 p-4 neo-border rounded-full flex items-center justify-center shadow-lg">
        <svg class="w-10 h-10 md:w-12 md:h-12 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.5 5.5l-11 11m11-11v11m0-11h-11"/>
        </svg>
      </div>
      <span>Selected Projects</span>
    </h2>
    <a href="{{ github }}" target="_blank" class="font-black uppercase text-xl underline decoration-4 underline-offset-8 decoration-yellow-400 hover:text-pink-500 transition-colors">
      See All Repos &rarr;
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16">
    {% for project in projects %}
    <article class="bg-{{ project.color }} p-10 pt-12 neo-border neo-shadow-lg flex flex-col h-full neo-hover relative group">

      {# Featured badge #}
      {% if project.featured %}
      <div class="absolute -top-6 left-10 bg-black text-white px-6 py-2 neo-border font-black uppercase -rotate-2 group-hover:rotate-0 transition-transform tracking-widest text-sm shadow-xl">
        {{ project.featured }}
      </div>
      {% endif %}

      <div class="flex justify-between items-start mb-8">
        <h3 class="text-3xl md:text-4xl font-black uppercase leading-none tracking-tight">
          {% for line in project.lines %}{{ line }}<br />{% endfor %}
        </h3>

        {# Icon #}
        <div class="w-16 h-16 bg-white border-4 border-black rounded-full flex items-center justify-center shadow-[6px_6px_0_0_rgba(0,0,0,1)] shrink-0">
          {% if project.icon == "plus" %}
          <svg class="w-2/3 h-2/3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M12 4v16m8-8H4"/></svg>
          {% elif project.icon == "check" %}
          <svg class="w-2/3 h-2/3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 002 2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          {% elif project.icon == "map" %}
          <svg class="w-2/3 h-2/3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          {% elif project.icon == "server" %}
          <svg class="w-2/3 h-2/3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>
          {% endif %}
        </div>
      </div>

      {# Bullet highlights #}
      {% if project.highlights %}
      <ul class="list-disc list-inside mb-10 font-bold text-lg flex-1 space-y-4 marker:text-black leading-snug">
        {% for highlight in project.highlights %}
        <li>{{ highlight }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      {# Prose description fallback #}
      {% if project.description %}
      <p class="font-bold text-xl mb-10 flex-1 leading-relaxed">{{ project.description }}</p>
      {% endif %}

      {# Tech tags #}
      <div class="flex gap-3 flex-wrap mt-auto">
        {% for tag in project.tags %}
        <span class="px-3 py-1 bg-white neo-border text-xs font-black shadow-[3px_3px_0_0_rgba(0,0,0,1)] uppercase tracking-tighter">{{ tag }}</span>
        {% endfor %}
      </div>

    </article>
    {% endfor %}
  </div>
</section>
