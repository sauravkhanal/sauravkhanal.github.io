<section id="work" class="space-y-8 scroll-mt-24">
  <div class="flex items-baseline justify-between border-b border-subtle pb-4">
    <div class="flex items-center gap-3">
      <h2 class="font-mono text-xs uppercase tracking-widest text-neutral-500 dark:text-neutral-400">
        01 / Selected Work
      </h2>
    </div>
    <a href="{{ github }}?tab=repositories" target="_blank" rel="noopener noreferrer" class="editorial-link font-mono text-xs text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100">
      Archive & All Repositories <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
    {% for project in projects %}
    <article class="py-8 sm:py-10 first:pt-2 last:pb-2 group transition-colors">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
        
        <!-- Index & Meta Header -->
        <div class="md:col-span-3 flex md:flex-col justify-between items-baseline md:items-start gap-2">
          <span class="font-mono text-sm font-semibold text-neutral-400 dark:text-neutral-600">
            {{ project.id }}
          </span>
          <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400">
            {{ project.subtitle }}
          </span>
        </div>

        <!-- Project Content -->
        <div class="md:col-span-9 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <h3 class="text-xl sm:text-2xl font-medium tracking-tight text-neutral-950 dark:text-neutral-50">
              {{ project.title }}
            </h3>
            {% if project.github %}
            <a
              href="{{ project.github }}"
              target="_blank"
              rel="noopener noreferrer"
              class="editorial-link font-mono text-xs text-neutral-700 dark:text-neutral-300 shrink-0 self-start sm:self-auto"
              aria-label="View source code for {{ project.title }} on GitHub"
            >
              Source Code <span aria-hidden="true">↗</span>
            </a>
            {% endif %}
          </div>

          <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
            {{ project.description }}
          </p>

          <!-- Tech metadata -->
          <div class="pt-2 flex flex-wrap gap-1.5 font-mono text-xs text-neutral-500 dark:text-neutral-400">
            {% for tag in project.tags %}
            <span class="tech-tag">{{ tag }}</span>
            {% endfor %}
          </div>
        </div>

      </div>
    </article>
    {% endfor %}
  </div>
</section>
