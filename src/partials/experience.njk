<section id="experience" class="space-y-8 scroll-mt-24">
  <div class="border-b border-subtle pb-4">
    <h2 class="font-mono text-xs uppercase tracking-widest text-neutral-600 dark:text-neutral-400">
      02 / Experience
    </h2>
  </div>

  <div class="divide-y divide-neutral-200 dark:divide-neutral-800">
    {% for job in experience %}
    <article class="py-8 sm:py-10 first:pt-2 last:pb-2">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
        
        <!-- Period & Company -->
        <div class="md:col-span-4 space-y-1">
          <time class="font-mono text-xs text-neutral-600 dark:text-neutral-400 block font-medium">
            {{ job.period }}
          </time>
          <div class="font-medium text-neutral-950 dark:text-neutral-100 text-sm sm:text-base">
            {{ job.company }}
          </div>
          <div class="font-mono text-xs text-neutral-600 dark:text-neutral-400">
            {{ job.location }}
          </div>
        </div>

        <!-- Role & Details -->
        <div class="md:col-span-8 space-y-3">
          <h3 class="text-lg font-medium text-neutral-950 dark:text-neutral-50">
            {{ job.role }}
          </h3>
          <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed max-w-2xl">
            {{ job.description }}
          </p>

          {% if job.tags %}
          <div class="pt-2 flex flex-wrap gap-1.5 font-mono text-xs text-neutral-600 dark:text-neutral-400">
            {% for tag in job.tags %}
            <span class="tech-tag">{{ tag }}</span>
            {% endfor %}
          </div>
          {% endif %}
        </div>

      </div>
    </article>
    {% endfor %}
  </div>
</section>
