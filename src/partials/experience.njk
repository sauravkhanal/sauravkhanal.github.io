<section id="experience" class="pt-10 scroll-mt-24 min-h-[calc(100vh-120px)] flex flex-col justify-center">
  <h2 class="text-4xl md:text-6xl font-black uppercase mb-12 flex items-center gap-4">
    <div class="bg-blue-300 p-4 neo-border rounded-full flex items-center justify-center shadow-lg">
      <svg class="w-10 h-10 md:w-12 md:h-12 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
    </div>
    <span>Experience</span>
  </h2>

  <div class="space-y-12 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-2 before:bg-black before:border-x-2 before:border-gray-800">
    {% for job in experience %}
    <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">

      {# Timeline dot #}
      <div class="flex items-center justify-center w-12 h-12 rounded-full neo-border bg-white text-black shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10 shadow-[6px_6px_0_0_rgba(0,0,0,1)] group-hover:bg-{{ job.dotColor }} group-hover:scale-110 transition-transform">
        <span class="w-3 h-3 bg-black rounded-full"></span>
      </div>

      {# Job card #}
      <div class="w-[calc(100%-4rem)] md:w-[calc(50%-3rem)] bg-white p-8 md:p-10 neo-border neo-shadow neo-hover {{ 'rotate-1' if loop.index % 2 == 0 else '-rotate-1' }} group-hover:rotate-0">
        <div class="bg-{{ job.color }} inline-block px-4 py-1 neo-border font-black text-sm uppercase mb-6 shadow-[3px_3px_0_0_rgba(0,0,0,1)]">
          {{ job.period }}
        </div>

        <h3 class="text-2xl md:text-3xl font-black uppercase leading-tight">{{ job.role }}</h3>

        <p class="text-xl md:text-2xl font-bold bg-yellow-200 inline-block px-3 mt-3 neo-border">
          {{ job.company }}
        </p>

        {% if job.description %}
        <p class="font-medium text-lg leading-relaxed text-gray-700 mt-4">{{ job.description }}</p>
        {% endif %}

        {% if job.tags %}
        <div class="mt-6 flex flex-wrap gap-2">
          {% for tag in job.tags %}
          <span class="text-xs font-black uppercase border-2 border-black px-2 py-0.5">{{ tag }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>

    </div>
    {% endfor %}
  </div>
</section>
