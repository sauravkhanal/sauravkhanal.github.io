<footer class="mt-40 border-t-8 border-black bg-cyan-300 px-6 py-24 text-center relative overflow-hidden">
  <div class="absolute -top-20 -left-20 w-60 h-60 bg-pink-400 rounded-full border-8 border-black opacity-30 animate-pulse"></div>
  <div class="absolute -bottom-20 -right-20 w-80 h-80 bg-yellow-300 rounded-full border-8 border-black opacity-30 translate-x-10 translate-y-10"></div>

  <div class="relative z-10 max-w-5xl mx-auto">
    <h2 class="text-6xl md:text-9xl font-black uppercase mb-4 leading-none tracking-tighter">
      Let's <br class="md:hidden" /> Talk!
    </h2>
    <div class="mb-12">
      <a href="mailto:{{ email }}" class="inline-block px-6 py-3 bg-orange-500 neo-border neo-shadow-sm font-bold font-mono text-lg md:text-xl hover:-translate-x-1 hover:-translate-y-1 transition-all lowercase">
        {{ email }}
      </a>
    </div>

    <div class="flex justify-center gap-6 md:gap-10 mb-16 flex-wrap">
      <a href="{{ github }}" target="_blank" aria-label="GitHub" class="w-24 h-24 bg-white neo-border neo-shadow-lg neo-hover neo-active flex items-center justify-center text-black -rotate-3 p-4">
        <svg class="w-full h-full fill-current" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <a href="{{ linkedin }}" target="_blank" aria-label="LinkedIn" class="w-24 h-24 bg-blue-600 neo-border neo-shadow-lg neo-hover neo-active flex items-center justify-center text-white rotate-3 p-4">
        <svg class="w-full h-full fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
      </a>
    </div>

    <div class="bg-black text-white inline-block px-6 py-3 neo-border border-white shadow-[6px_6px_0_0_#fde047] font-black text-sm md:text-lg uppercase tracking-widest mt-6 mb-6 -rotate-1 hover:rotate-0 transition-transform cursor-default select-none">
      {{ name }} &copy; <span id="year"></span>
    </div>
    <p class="mt-4 font-bold text-gray-700 italic">Fast. Accessible. Bold.</p>
  </div>
</footer>
