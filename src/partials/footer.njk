<footer id="contact" class="w-full border-t border-subtle mt-16 sm:mt-24 pt-12 pb-16 transition-colors">
  <div class="w-full max-w-4xl mx-auto px-4 sm:px-8 space-y-12">
    
    <!-- Contact section -->
    <div class="space-y-8">
      <div class="space-y-2">
        <h2 class="font-mono text-xs uppercase tracking-widest text-neutral-600 dark:text-neutral-400">
          05 / Contact
        </h2>
        <p class="text-2xl sm:text-3xl font-medium tracking-tight text-neutral-950 dark:text-neutral-50">
          Let's connect.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
        
        <!-- Left: Direct Contact & Socials -->
        <div class="md:col-span-5 space-y-6">
          <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed">
            Whether you have an interesting project, an engineering inquiry, or want to discuss systems and web development, feel free to send a message or reach out directly.
          </p>

          <div class="space-y-4 font-mono text-xs sm:text-sm">
            <div>
              <span class="text-neutral-600 dark:text-neutral-400 block text-xs uppercase tracking-wider mb-1 font-medium">Direct Email</span>
              <div class="flex items-center gap-3">
                <a href="mailto:{{ email }}" class="editorial-link font-medium text-neutral-950 dark:text-neutral-100">
                  {{ email }} <span aria-hidden="true">↗</span>
                </a>
                <button
                  id="copyEmailBtn"
                  onclick="copyEmail(event)"
                  type="button"
                  class="font-mono text-xs text-neutral-600 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-neutral-100 underline underline-offset-4 cursor-pointer transition-colors"
                  aria-label="Copy email address to clipboard"
                >
                  Copy
                </button>
              </div>
            </div>

            <div class="pt-1">
              <span class="text-neutral-600 dark:text-neutral-400 block text-xs uppercase tracking-wider mb-1 font-medium">Profiles</span>
              <div class="flex gap-4">
                <a href="{{ github }}" target="_blank" rel="noopener noreferrer" class="editorial-link text-neutral-950 dark:text-neutral-100 font-medium">
                  GitHub <span aria-hidden="true">↗</span>
                </a>
                <a href="{{ linkedin }}" target="_blank" rel="noopener noreferrer" class="editorial-link text-neutral-950 dark:text-neutral-100 font-medium">
                  LinkedIn <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Formspree Contact Form -->
        <div class="md:col-span-7 bg-inherit">
          <form action="https://formspree.io/f/mgonkjwk" method="POST" class="space-y-4">
            <div>
              <label for="name" class="block font-mono text-xs text-neutral-600 dark:text-neutral-400 mb-1.5 uppercase tracking-wider font-medium">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
                class="editorial-input"
              />
            </div>

            <div>
              <label for="email" class="block font-mono text-xs text-neutral-600 dark:text-neutral-400 mb-1.5 uppercase tracking-wider font-medium">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="your.email@example.com"
                class="editorial-input"
              />
            </div>

            <div>
              <label for="message" class="block font-mono text-xs text-neutral-600 dark:text-neutral-400 mb-1.5 uppercase tracking-wider font-medium">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Tell me about your project or inquiry..."
                class="editorial-input resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 bg-neutral-950 dark:bg-neutral-100 text-white dark:text-neutral-950 font-mono text-xs font-medium tracking-wide uppercase hover:opacity-85 transition-opacity cursor-pointer"
            >
              Send Message <span aria-hidden="true">↗</span>
            </button>
          </form>
        </div>

      </div>
    </div>

    <!-- Colophon / Fine print -->
    <div class="pt-8 border-t border-subtle flex flex-col sm:flex-row justify-between items-baseline gap-4 font-mono text-xs text-neutral-600 dark:text-neutral-400">
      <div>
        © <span id="year">2026</span> {{ name }}. Built with Nunjucks, HTML & CSS.
      </div>
      <div class="text-xs text-neutral-600 dark:text-neutral-400">
        Zero frameworks · No tracking · Minimal JavaScript
      </div>
    </div>

  </div>
</footer>
