<div
  id="contactModal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6 bg-black/60 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalHeading"
>
  <div class="bg-white neo-border shadow-[12px_12px_0_0_rgba(0,0,0,1)] w-full max-w-2xl overflow-hidden relative">
    <!-- Modal Header -->
    <div class="bg-pink-300 border-b-4 border-black p-4 sm:p-6 flex justify-between items-center">
      <h2 id="modalHeading" class="text-xl sm:text-3xl font-black uppercase tracking-tighter italic">
        Let's Work Together
      </h2>
      <button
        onclick="toggleModal()"
        aria-label="Close Modal"
        class="w-10 h-10 sm:w-12 sm:h-12 bg-white neo-border flex items-center justify-center font-black text-xl sm:text-2xl hover:bg-black hover:text-white transition-colors uppercase"
      >
        X
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2">
      <!-- Form Section -->
      <div class="p-8 border-b-4 md:border-b-0 md:border-r-4 border-black">
        <form action="https://formspree.io/f/mgonkjwk" method="POST" class="space-y-4">
          <div>
            <label class="block font-black uppercase text-xs mb-1">Your Name</label>
            <input type="text" name="name" required placeholder="John Doe" class="w-full p-3 neo-border focus:bg-yellow-50 outline-none font-bold" />
          </div>
          <div>
            <label class="block font-black uppercase text-xs mb-1">Email Address</label>
            <input type="email" name="email" required placeholder="john@example.com" class="w-full p-3 neo-border focus:bg-cyan-50 outline-none font-bold" />
          </div>
          <div>
            <label class="block font-black uppercase text-xs mb-1">Message</label>
            <textarea rows="4" name="message" required placeholder="Tell me about your project..." class="w-full p-3 neo-border focus:bg-pink-50 outline-none font-bold resize-none"></textarea>
          </div>
          <button type="submit" class="w-full bg-black text-white font-black py-4 neo-border shadow-[4px_4px_0_0_rgba(0,0,255,1)] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none transition-all uppercase">
            Send Inquiry
          </button>
        </form>
      </div>

      <!-- Direct Contact Section -->
      <div class="p-8 bg-yellow-100 space-y-8">
        <div>
          <h3 class="font-black uppercase text-sm mb-4 bg-black text-white inline-block px-2">Talk Right Now</h3>
          <a href="tel:{{ phoneUrl }}" class="font-bold text-lg mb-2 underline decoration-pink-500 decoration-4 block hover:text-pink-600 transition-colors">
            {{ phone }}
          </a>
          <p class="text-sm font-medium italic">Available 9AM - 6PM NPT</p>
        </div>
        <div>
          <h3 class="font-black uppercase text-sm mb-4 bg-black text-white inline-block px-2">Primary Email</h3>
          <a href="mailto:{{ email }}" class="font-bold text-lg break-all underline decoration-cyan-500 decoration-2 hover:text-cyan-600 transition-colors block">
            {{ email }}
          </a>
        </div>
        <div class="pt-4">
          <p class="font-black uppercase text-xs mb-4">Social Presence</p>
          <div class="flex gap-4 w-full">
            <a href="{{ github }}" class="w-10 h-10 bg-white neo-border flex items-center justify-center neo-shadow-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-none transition-all">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            </a>
            <a href="{{ linkedin }}" class="w-10 h-10 bg-blue-600 text-white neo-border flex items-center justify-center neo-shadow-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-none transition-all">
              <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
