<section id="hero" class="pt-6 sm:pt-10 space-y-6 sm:space-y-8">
  <div class="flex items-center gap-2.5">
    <span class="relative flex h-2 w-2">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
    </span>
    <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400 tracking-tight">
      {{ location }} · {{ status }}
    </span>
  </div>

  <div class="space-y-4">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-semibold tracking-tight leading-[1.15] text-neutral-950 dark:text-neutral-50 max-w-3xl">
      Software engineer building reliable, high-performance systems for the web.
    </h1>
    <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl leading-relaxed">
      I'm <span class="text-neutral-900 dark:text-neutral-100 font-medium">{{ name }}</span>. I design and build full-stack web applications and backend systems with TypeScript, React, Node.js, and containerized cloud infrastructure.
    </p>
  </div>

  <div class="pt-2 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-xs sm:text-sm">
    <a href="#work" class="editorial-link font-medium">
      Selected Work <span aria-hidden="true">↓</span>
    </a>
    <span class="text-neutral-300 dark:text-neutral-700 select-none">/</span>
    <a href="{{ github }}" target="_blank" rel="noopener noreferrer" class="editorial-link">
      GitHub <span aria-hidden="true">↗</span>
    </a>
    <span class="text-neutral-300 dark:text-neutral-700 select-none">/</span>
    <a href="{{ linkedin }}" target="_blank" rel="noopener noreferrer" class="editorial-link">
      LinkedIn <span aria-hidden="true">↗</span>
    </a>
    <span class="text-neutral-300 dark:text-neutral-700 select-none">/</span>
    <a href="mailto:{{ email }}" class="editorial-link">
      {{ email }}
    </a>
  </div>
</section>
