  <div class="flex-1 flex justify-center w-full max-w-[240px] sm:max-w-sm md:max-w-md lg:max-w-xl">
    <div class="w-full aspect-square bg-lime-300 rounded-full neo-border neo-shadow-lg flex items-center justify-center rotate-3 hover:rotate-6 transition-transform duration-500 relative border-8">
      <svg class="w-[70%] h-[70%] text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
      </svg>
      <div class="absolute -top-2 -right-2 sm:-top-4 sm:-right-4 w-12 h-12 sm:w-16 sm:h-16 bg-yellow-300 neo-border rounded-lg rotate-12 flex items-center justify-center font-black text-lg sm:text-2xl shadow-lg animate-bounce">JS</div>
      <div class="absolute -bottom-4 left-0 sm:-bottom-8 w-14 h-14 sm:w-20 sm:h-20 bg-pink-400 neo-border rounded-full flex items-center justify-center font-black text-sm sm:text-xl -rotate-12 shadow-lg">TS</div>
    </div>
  </div>
</section>
