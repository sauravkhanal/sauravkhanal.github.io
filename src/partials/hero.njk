<section id="home" class="flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16 mt-4 md:mt-20 px-2 sm:px-0">
  <div class="flex-1 space-y-8 text-center lg:text-left w-full">
    <div class="flex flex-col sm:flex-row items-center lg:items-start gap-4">
      <div class="inline-block px-4 py-2 bg-pink-300 neo-border neo-shadow-sm font-extrabold text-[10px] sm:text-xs tracking-widest uppercase">
        {{ title }}
      </div>
      <div class="flex items-center gap-2 px-3 py-1 bg-white neo-border text-[10px] sm:text-xs font-bold uppercase">
        <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
        Shipping high-quality code
      </div>
    </div>

    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl font-black uppercase leading-[0.95] md:leading-[0.9] tracking-tighter">
      Build <br />
      <span class="bg-cyan-300 px-2 sm:px-3 inline-block neo-border rotate-1 my-1 sm:my-2">Better</span>
      <br />
      Web.
    </h1>

    <p class="text-xl md:text-3xl font-medium max-w-xl leading-snug mx-auto lg:mx-0 bg-white p-6 neo-border neo-shadow -rotate-1">
      Hi, I'm <span class="underline decoration-pink-400">{{ name }}</span>.
      {{ title }} specializing in <span class="font-black">Scalable Architecture</span> and the MERN stack.
    </p>

    <div class="flex items-center justify-center lg:justify-start flex-wrap gap-4 sm:gap-6 pt-2 sm:pt-4">
      <a href="#projects" class="px-6 py-4 sm:px-10 sm:py-5 bg-yellow-300 text-black font-black text-lg sm:text-xl tracking-wide uppercase neo-border neo-shadow-lg neo-hover neo-active">
        View My Work
      </a>
      <div class="flex gap-3 sm:gap-4">
        <a href="{{ github }}" target="_blank" aria-label="GitHub"
           class="w-12 h-12 sm:w-16 sm:h-16 bg-white flex items-center justify-center neo-border neo-shadow neo-hover neo-active text-black p-2">
          <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
