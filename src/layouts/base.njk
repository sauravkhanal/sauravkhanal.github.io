<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ name }} — {{ title }}</title>
    <meta
      name="description"
      content="{{ bio }}"
    />
    <meta name="author" content="{{ name }}" />
    <link rel="canonical" href="{{ siteUrl }}" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ siteUrl }}" />
    <meta property="og:title" content="{{ name }} — {{ title }}" />
    <meta property="og:description" content="{{ bio }}" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ name }} — {{ title }}" />
    <meta name="twitter:description" content="{{ bio }}" />

    <link rel="icon" href="favicon.ico" />
    <link rel="stylesheet" href="output.css" />
    <meta name="google-site-verification" content="duwbZfPpMM0cqVjAYxu7_LLvckwPcaTAJJKhHY5rEO0" />
  </head>
  <body class="min-h-screen flex flex-col selection:bg-neutral-800 selection:text-white">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    {% include "partials/navbar.njk" %}

    <main id="main-content" class="w-full max-w-4xl mx-auto px-5 sm:px-8 py-10 sm:py-16 flex-1 space-y-20 sm:space-y-28">
      {% block content %}{% endblock %}
    </main>

    {% include "partials/footer.njk" %}

    <script>
      // Dynamic Year
      const yearEl = document.getElementById("year");
      if (yearEl) {
        yearEl.textContent = new Date().getFullYear();
      }

      // Quick email copy feedback helper
      function copyEmail(e) {
        if (e) e.preventDefault();
        const email = "{{ email }}";
        navigator.clipboard.writeText(email).then(() => {
          const btn = document.getElementById("copyEmailBtn");
          if (btn) {
            const originalText = btn.innerHTML;
            btn.innerHTML = "Copied to clipboard ✓";
            btn.classList.add("text-emerald-600");
            setTimeout(() => {
              btn.innerHTML = originalText;
              btn.classList.remove("text-emerald-600");
            }, 2000);
          }
        }).catch(() => {
          window.location.href = "mailto:" + "{{ email }}";
        });
      }
    </script>
  </body>
</html>