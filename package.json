{
  "name": "neo-portfolio",
  "version": "1.0.0",
  "scripts": {
    "build:html": "node build.js",
    "build:css": "npx @tailwindcss/cli -i ./global.css -o ./output.css --minify",
    "watch:html": "node build.js --watch",
    "watch:css": "npx @tailwindcss/cli -i ./global.css -o ./output.css --watch",
    "dev": "concurrently \"npm run watch:html\" \"npm run watch:css\"",
    "build": "npm run build:html && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "concurrently": "^8.2.2",
    "nunjucks": "^3.2.4",
    "nunjucks-cli": "^1.0.0",
    "tailwindcss": "^4.2.1"
  }
}
